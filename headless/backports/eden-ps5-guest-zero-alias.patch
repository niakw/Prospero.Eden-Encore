 struct Memory::Impl {
     explicit Impl(Core::System& system_) : system{system_} {}
 
+#ifdef PS5_NATIVE
+    // Delta-zero page pointers are not necessarily unmapped: when valid
+    // guest VA and host VA coincide, their stored difference is zero.
+    // Bounds-check against the same allocation size used by DeviceMemory.
+    [[nodiscard]] bool IsDirectBackingAlias(u64 address, std::size_t bytes) const {
+        const auto base = reinterpret_cast<std::uintptr_t>(
+            system.DeviceMemory().buffer.BackingBasePointer());
+        const std::size_t capacity =
+            Kernel::Board::Nintendo::Nx::KSystemControl::Init::GetIntendedMemorySize();
+        return base != 0 && address >= base && bytes <= capacity &&
+               address - base <= capacity - bytes;
+    }
+#endif
