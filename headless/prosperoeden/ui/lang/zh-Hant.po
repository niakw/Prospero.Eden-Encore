#: eden_services.cpp, host/fake_services.cpp
msgid "{0} not available"
msgstr "{0}無法使用"

#. Position in a list: 3 OF 12.
#: pe/ui/widgets.cpp
msgid "{0} OF {1}"
msgstr "{0} / {1}"

