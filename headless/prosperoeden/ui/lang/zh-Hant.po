#: pe/ui/library.cpp
msgid "{0} of {1} on"
msgstr "已開啟 {0}/{1}"

#. A percentage (a volume): write it as the language does, for example with a space before the sign.
#: pe/ui/library.cpp, pe/ui/settings.cpp
msgid "{0}%"
msgstr "{0}%"

