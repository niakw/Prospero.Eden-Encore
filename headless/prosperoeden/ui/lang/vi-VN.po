#: pe/ui/settings.cpp
msgid "Vulkan is recommended on PS5. Use OpenGL only as a fallback for a game with Vulkan issues."
msgstr "Vulkan được khuyên dùng trên PS5. Chỉ sử dụng OpenGL làm phương án dự phòng cho trò chơi có vấn đề về Vulkan."

#: pe/ui/library.cpp
